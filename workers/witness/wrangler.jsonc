{
  // sentinel-witness — the Witness record as deployed infrastructure.
  // One rules module, three runtimes: the browser plays it, node --test
  // guards it, and this Worker certifies it — same bytes in all three.
  "name": "sentinel-witness",
  "main": "worker.js",
  "compatibility_date": "2026-07-28",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // the match archive: certified records filed by content-derived key,
  // so filing is idempotent — a match is itself, no matter how often
  // it is submitted
  "kv_namespaces": [
    { "binding": "RECORDS", "id": "31212ee4c4d04d4dadeb8212e1ffa3a5" }
  ]
}
